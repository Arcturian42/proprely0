# Proprely SPA — Apache rewrite for Hostinger
# Known routes are pre-rendered as static index.html files (served via -d/-f match).
# Unknown URLs return a real HTTP 404 with the custom 404.html page.

Options -MultiViews
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ─── Redirections 301 historiques ────────────────────────────────────
# URLs incorrectes générées par l'ancien llms.txt statique
# (/ressources/calculateur-roi pointait vers une page inexistante).
# 301 vers les vraies URLs racine pour ne pas perdre le jus SEO.
RewriteRule ^ressources/calculateur-roi/?$ /calculateur-roi/ [R=301,L]
RewriteRule ^ressources/simulateur-rentabilite/?$ /simulateur-rentabilite/ [R=301,L]
RewriteRule ^ressources/calculateur-prix-nettoyage-m2/?$ /calculateur-prix-nettoyage-m2/ [R=301,L]
RewriteRule ^ressources/calculateur-roi-nettoyage/?$ /calculateur-roi/ [R=301,L]

# If a real file or directory exists, serve it as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, return a real HTTP 404 (Apache will serve /404.html via ErrorDocument)
RewriteRule ^ - [R=404,L]

# Cache et signaux de fraîcheur pour les bots (Googlebot, Bingbot, etc.)
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML : revalidation forte mais on autorise un petit cache navigateur (5 min)
  # pour ne pas pénaliser les Core Web Vitals. Avant : no-cache + no-store qui
  # supprimaient le ETag/Last-Modified, donc pas de signal de fraîcheur pour
  # Googlebot. Maintenant : revalidation obligatoire mais via 304 Not Modified.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# Active Last-Modified et ETag sur tous les fichiers (signal de fraîcheur
# explicite pour les crawlers : si la page n'a pas changé, le serveur répond
# 304 Not Modified et économise du budget de crawl).
FileETag MTime Size

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
